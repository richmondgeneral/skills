<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.richmondgeneral.square-crm-sync</string>
    
    <key>ProgramArguments</key>
    <array>
        <string>/Users/scottybe/workspace/richmondgeneral/skills/square-crm/scripts/auto_sync.sh</string>
    </array>
    
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/scottybe</string>
        <!-- SQUARE_TOKEN will be sourced from ~/.zshrc via login shell -->
    </dict>
    
    <key>StandardOutPath</key>
    <string>/Users/scottybe/workspace/richmondgeneral/skills/square-crm/logs/launchd.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/scottybe/workspace/richmondgeneral/skills/square-crm/logs/launchd.err.log</string>
    
    <key>RunAtLoad</key>
    <false/>
    
    <key>KeepAlive</key>
    <false/>
    
    <!-- Only run if MongoDB is available -->
    <key>LaunchOnlyOnce</key>
    <false/>
</dict>
</plist>
